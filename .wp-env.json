{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",

  "core": null,

  "themes": [
    "./themes/staark",
    "./themes/staark-salong",
    "./themes/staark-bygg",
    "./themes/staark-gastfrihet"
  ],

  "plugins": [
    "./plugins/staark-core"
  ],

  "mappings": {
    "wp-content/mu-plugins/staark-loader.php": "./plugins/staark-core/deployment/staark-loader.php"
  },

  "port": 8888,

  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_DISPLAY": false,
    "WP_DEBUG_LOG": false,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "staging",
    "WP_HOME": "https://wp.staarkinc.com",
    "WP_SITEURL": "https://wp.staarkinc.com"
  },
  
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp config set WP_HOME https://wp.staarkinc.com --type=constant && wp-env run cli wp config set WP_SITEURL https://wp.staarkinc.com --type=constant"
  }
}
