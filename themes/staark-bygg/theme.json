{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "typography": {
      "fontSizes": [
        { "slug": "xs", "size": "0.78rem", "name": "XS" },
        { "slug": "sm", "size": "0.875rem", "name": "Small" },
        { "slug": "md", "size": "1rem", "name": "Medium" },
        { "slug": "lg", "size": "1.125rem", "name": "Large" },
        { "slug": "xl", "size": "clamp(1.4rem, 2.2vw, 1.75rem)", "name": "XL" },
        { "slug": "2-xl", "size": "clamp(2.3rem, 4.6vw, 4rem)", "name": "2XL" },
        { "slug": "hero", "size": "clamp(3rem, 7vw, 6.4rem)", "name": "Hero" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "lineHeight": "1.04",
          "letterSpacing": "-0.02em"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ink",
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "0.95rem"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-canvas",
      "title": "Bygg — full width (no title)",
      "postTypes": ["page"]
    }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
