{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#101828",
          "name": "Ink"
        },
        {
          "slug": "muted",
          "color": "#667085",
          "name": "Muted"
        },
        {
          "slug": "line",
          "color": "#E4E7EC",
          "name": "Line"
        },
        {
          "slug": "paper",
          "color": "#FFFCF8",
          "name": "Paper"
        },
        {
          "slug": "surface",
          "color": "#F7F4EF",
          "name": "Surface"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "primary",
          "color": "#2457F5",
          "name": "Staark Blue"
        },
        {
          "slug": "primary-dark",
          "color": "#173BB7",
          "name": "Staark Blue Dark"
        },
        {
          "slug": "primary-soft",
          "color": "#EEF3FF",
          "name": "Staark Blue Soft"
        },
        {
          "slug": "success",
          "color": "#0F9F6E",
          "name": "Success"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "2xs",
          "size": "6px",
          "name": "2XS"
        },
        {
          "slug": "xs",
          "size": "10px",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "16px",
          "name": "SM"
        },
        {
          "slug": "md",
          "size": "24px",
          "name": "MD"
        },
        {
          "slug": "lg",
          "size": "40px",
          "name": "LG"
        },
        {
          "slug": "xl",
          "size": "64px",
          "name": "XL"
        },
        {
          "slug": "2-xl",
          "size": "96px",
          "name": "2XL"
        },
        {
          "slug": "3-xl",
          "size": "128px",
          "name": "3XL"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Staark Sans",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.78rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "1.125rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "clamp(1.3rem, 1.8vw, 1.5rem)",
          "name": "XL"
        },
        {
          "slug": "2-xl",
          "size": "clamp(2rem, 3.4vw, 3rem)",
          "name": "2XL"
        },
        {
          "slug": "hero",
          "size": "clamp(2.5rem, 5vw, 4.25rem)",
          "name": "Hero"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|md",
      "padding": {
        "left": "clamp(20px,4vw,48px)",
        "right": "clamp(20px,4vw,48px)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|md",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "650",
          "lineHeight": "1.1",
          "letterSpacing": "-0.025em"
        }
      },
      "button": {
        "border": {
          "radius": "10px"
        },
        "typography": {
          "fontWeight": "700",
          "fontSize": "0.95rem"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        }
      }
    },
    "blocks": {
      "core/button": {
        "spacing": {
          "padding": {
            "top": "14px",
            "right": "22px",
            "bottom": "14px",
            "left": "22px"
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.95rem",
          "fontWeight": "650"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-canvas",
      "title": "Full width (no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
