{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "primary", "color": "#2563eb", "name": "Staark Blue" },
        { "slug": "primary-dark", "color": "#1d4ed8", "name": "Staark Blue Dark" },
        { "slug": "dark", "color": "#0f172a", "name": "Dark" },
        { "slug": "muted", "color": "#64748b", "name": "Muted" },
        { "slug": "soft", "color": "#cbd5e1", "name": "Soft Text" },
        { "slug": "border", "color": "#e2e8f0", "name": "Border" },
        { "slug": "surface", "color": "#f8fafc", "name": "Surface" },
        { "slug": "white", "color": "#ffffff", "name": "White" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "xs", "size": "8px", "name": "XS" },
        { "slug": "sm", "size": "16px", "name": "SM" },
        { "slug": "md", "size": "24px", "name": "MD" },
        { "slug": "lg", "size": "40px", "name": "LG" },
        { "slug": "xl", "size": "64px", "name": "XL" },
        { "slug": "2-xl", "size": "96px", "name": "2XL" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System Sans",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "sm", "size": "0.875rem", "name": "Small" },
        { "slug": "md", "size": "1rem", "name": "Medium" },
        { "slug": "lg", "size": "1.125rem", "name": "Large" },
        { "slug": "xl", "size": "1.5rem", "name": "XL" },
        { "slug": "2-xl", "size": "clamp(2rem, 4vw, 3.25rem)", "name": "2XL" },
        { "slug": "hero", "size": "clamp(2.8rem, 7vw, 5.75rem)", "name": "Hero" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|dark"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|md",
      "padding": {
        "left": "clamp(20px, 4vw, 48px)",
        "right": "clamp(20px, 4vw, 48px)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|md",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.08",
          "letterSpacing": "-0.035em"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        }
      }
    },
    "blocks": {
      "core/button": {
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "22px",
            "bottom": "12px",
            "left": "22px"
          }
        }
      }
    }
  }
}
